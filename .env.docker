# Docker environment configuration for Crove

# Rails
SECRET_KEY_BASE=replace_with_your_secret_key_use_rake_secret
RAILS_ENV=development
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info

# Frontend URL - Important for CORS
FRONTEND_URL=http://localhost:3010
HELPCENTER_URL=http://localhost:3010

# Database - Using external PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:5432/chatwoot_development

# Redis - Using external Redis
REDIS_URL=redis://host.docker.internal:6379/0

# Storage
ACTIVE_STORAGE_SERVICE=local

# Mail - Using Mailhog
SMTP_ADDRESS=mailhog
SMTP_PORT=1025
SMTP_DOMAIN=localhost
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=
SMTP_ENABLE_STARTTLS_AUTO=false
MAILER_SENDER_EMAIL=support@crove.app

# Account signup
ENABLE_ACCOUNT_SIGNUP=true

# Vite
VITE_RUBY_HOST=0.0.0.0
VITE_RUBY_PORT=3036
VITE_DEV_SERVER_HOST=vite

# Optional: OpenAI for AI features
# OPENAI_API_KEY=your_openai_key_here

# Optional: Disable enterprise features
DISABLE_ENTERPRISE=false