# Performance optimizations for Windows Docker
RAILS_CACHE_CLASSES=false
RAILS_EAGER_LOAD=false
WEB_CONCURRENCY=1
RAILS_MAX_THREADS=5
RAILS_MIN_THREADS=5
RAILS_ENV=development
NODE_ENV=development
INSTALLATION_NAME=Crove
SECRET_KEY_BASE=replace_with_your_secret_key
FRONTEND_URL=http://localhost:3010
FORCE_SSL=false
ENABLE_ACCOUNT_SIGNUP=true
REDIS_URL=redis://redis:6379
POSTGRES_HOST=DB
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=chatwoot_development
ACTIVE_STORAGE_SERVICE=local
RAILS_LOG_TO_STDOUT=true
USE_INBOX_AVATAR_FOR_BOT=true
MAILER_SENDER_EMAIL=Chatwoot <CROVE@incrove.local>
DEFAULT_LOCALE=en
AVAILABLE_LOCALES=en
LOG_LEVEL=info
LOG_SIZE=500
VITE_HOST=vite
VITE_PORT=3036
VITE_RUBY_HOST=0.0.0.0
VITE_RUBY_PORT=3036

# Disable features that slow down Windows
VERBOSE_QUERY_LOGS=false
USE_REDIS_CACHE=false